# Toolblip Frontend Environment Variables
# Copy to .env.local for local development

# Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Bing Webmaster Tools verification code (optional — leave empty to disable)
NEXT_PUBLIC_BING_VERIFICATION_CODE=

# API URL (Laravel backend)
NEXT_PUBLIC_API_URL=https://api.toolblip.com

# App URL (used for OG tags, canonical URLs)
NEXT_PUBLIC_APP_URL=https://toolblip.com
