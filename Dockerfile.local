# syntax=docker/dockerfile:1
# Local development — Next.js dev server with hot reload
# Usage:
#   docker build -f Dockerfile.local -t toolblip-local .
#   docker run -p 3000:3000 -v $(pwd):/app toolblip-local

FROM node:22-alpine

WORKDIR /app

# Install dependencies (including devDeps for TypeScript, webpack, etc.)
COPY package*.json ./
RUN npm ci

# Copy source
COPY . .

EXPOSE 3000

# Next.js dev server with hot reload
# Bind to 0.0.0.0 so it's accessible from host
CMD ["npm", "run", "dev", "--", "--turbopack"]
