---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Support Toolblip — Keep Free Developer Tools Running"
  description="Toolblip is free, forever. If it saved you time, a coffee keeps it running. Support via GitHub Sponsors or Ko-fi."
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-white mb-4">Support Toolblip</h1>
    <p class="text-gray-400 text-lg mb-10">
      toolblip.com is free, forever. No login. No tracking beyond standard analytics.
      If it saved you 10 minutes, a coffee keeps it running.
    </p>

    <!-- Stats row -->
    <div class="grid grid-cols-3 gap-4 mb-12">
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-white">10</div>
        <div class="text-xs text-gray-500 mt-1">Tools available</div>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-white">$0</div>
        <div class="text-xs text-gray-500 mt-1">Hosting cost (Cloudflare Pages)</div>
      </div>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 text-center">
        <div class="text-2xl font-bold text-green-400">100%</div>
        <div class="text-xs text-gray-500 mt-1">Client-side, no uploads</div>
      </div>
    </div>

    <!-- Support options -->
    <div class="space-y-4 mb-12">
      <a
        href="https://github.com/sponsors/HarunRRayhan"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-4 bg-gray-900 border border-gray-700 hover:border-gray-500 rounded-xl p-5 transition-colors group"
      >
        <div class="w-10 h-10 flex items-center justify-center bg-gray-800 rounded-lg shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-white" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </div>
        <div class="flex-1">
          <div class="font-semibold text-white group-hover:text-green-400 transition-colors">GitHub Sponsors</div>
          <div class="text-sm text-gray-400">Monthly or one-time. 0% fees — every dollar reaches the project.</div>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-600 group-hover:text-gray-400 transition-colors shrink-0" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <a
        href="https://ko-fi.com/toolblip"
        target="_blank"
        rel="noopener"
        class="flex items-center gap-4 bg-gray-900 border border-gray-700 hover:border-gray-500 rounded-xl p-5 transition-colors group"
      >
        <div class="w-10 h-10 flex items-center justify-center bg-gray-800 rounded-lg shrink-0">
          <span class="text-xl" aria-hidden="true">☕</span>
        </div>
        <div class="flex-1">
          <div class="font-semibold text-white group-hover:text-green-400 transition-colors">Ko-fi</div>
          <div class="text-sm text-gray-400">Buy a coffee. One-time, no account required. 0% platform fees.</div>
        </div>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-gray-600 group-hover:text-gray-400 transition-colors shrink-0" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Sponsor a tool -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-10">
      <h2 class="text-lg font-semibold text-white mb-2">Sponsor a tool page</h2>
      <p class="text-sm text-gray-400 mb-4">
        For $50/month, your company gets a tasteful "Powered by [Your Company]" attribution on one
        tool page — visible to every developer who uses that tool. No intrusive ads, just a quiet
        acknowledgment. Great for dev tool companies and SaaS products.
      </p>
      <a href="/advertise" class="inline-block text-sm text-green-400 hover:text-green-300 border border-green-500/30 hover:border-green-500/60 px-4 py-2 rounded-lg transition-colors">
        See advertising options →
      </a>
    </div>

    <p class="text-sm text-gray-600 text-center">
      Not in a position to donate? No worries — using the tools and sharing them with a friend is just as valuable.
    </p>
  </div>
</BaseLayout>
