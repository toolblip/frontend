---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support Toolblip — Donate" description="Toolblip is free, forever. If it saved you time, a coffee keeps it running.">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-white mb-4">Support Toolblip</h1>

    <p class="text-gray-300 leading-relaxed mb-10">
      Toolblip is free, forever. No login, no tracking, no paywalls. If it saved you 10 minutes today,
      a coffee keeps the lights on.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 mb-12">
      <a
        href="https://github.com/sponsors/HarunRRayhan"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center gap-3 bg-green-500 hover:bg-green-400 text-black font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        GitHub Sponsors
      </a>

      <a
        href="https://ko-fi.com/harunrrayhan"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center gap-3 font-semibold px-6 py-3.5 rounded-xl transition-colors text-sm text-white"
        style="background-color: #FF5E5B;"
        onmouseover="this.style.backgroundColor='#e85250'"
        onmouseout="this.style.backgroundColor='#FF5E5B'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z"/>
        </svg>
        Ko-fi
      </a>
    </div>

    <div class="border-t border-gray-800 pt-10">
      <h2 class="text-lg font-semibold text-white mb-3">Sponsor a tool</h2>
      <p class="text-gray-400 leading-relaxed">
        For <span class="text-white font-medium">$50/month</span>, get tasteful
        <span class="text-gray-300">"Powered by [Your Company]"</span> attribution on a single tool page.
        Reaches developers directly while they're using the tool.
      </p>
      <p class="text-gray-500 text-sm mt-3">
        For broader sponsorship options and media kit, see the <a href="/advertise" class="text-green-400 hover:text-green-300 transition-colors">/advertise</a> page.
      </p>
    </div>
  </div>
</BaseLayout>
