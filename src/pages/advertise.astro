---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Advertise on Toolblip" description="Reach developers with a sponsor slot on Toolblip">
  <div class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-white mb-4">Advertise on Toolblip</h1>
    <p class="text-gray-400 mb-10">Toolblip is a growing collection of free developer tools used by developers every day.</p>

    <div class="space-y-10">
      <section>
        <h2 class="text-lg font-semibold text-white mb-3">Audience</h2>
        <p class="text-gray-300 leading-relaxed">
          Developers using tools like JSON formatters, base64 encoders, UUID generators, and more.
          Primarily web developers, backend engineers, and DevOps professionals.
          Growing audience  -  exact traffic numbers available on request.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white mb-3">Formats</h2>
        <ul class="space-y-2 text-gray-300">
          <li class="flex gap-3">
            <span class="text-green-400 shrink-0">Above-tool banner</span>
            <span class="text-gray-500"> -  shown above the tool UI on every tool page</span>
          </li>
          <li class="flex gap-3">
            <span class="text-green-400 shrink-0">Below-tool banner</span>
            <span class="text-gray-500"> -  shown below the tool output, after the user gets their result</span>
          </li>
          <li class="flex gap-3">
            <span class="text-green-400 shrink-0">Per-tool sponsorship</span>
            <span class="text-gray-500"> -  exclusive placement on a single high-traffic tool</span>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white mb-3">Pricing</h2>
        <p class="text-gray-300 leading-relaxed">
          Sponsor slots start at <span class="text-white font-medium">$100/month</span>.
          Discounts available for quarterly or annual bookings.
          All sponsors are clearly labeled  -  no deceptive placements.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-white mb-3">Get in touch</h2>
        <p class="text-gray-300 leading-relaxed mb-4">
          Send an email with your product, target audience, and preferred format.
        </p>
        <a
          href="mailto:harun@toolblip.com"
          class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-400 text-black font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm"
        >
          Email harun@toolblip.com
        </a>
      </section>
    </div>
  </div>
</BaseLayout>
