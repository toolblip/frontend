---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const cases = [
  { label: 'UPPERCASE', id: 'upper' },
  { label: 'lowercase', id: 'lower' },
  { label: 'Title Case', id: 'title' },
  { label: 'Sentence case', id: 'sentence' },
  { label: 'camelCase', id: 'camel' },
  { label: 'PascalCase', id: 'pascal' },
  { label: 'snake_case', id: 'snake' },
  { label: 'kebab-case', id: 'kebab' },
];
---

<ToolLayout
  title="Case Converter Online Free — Toolblip"
  description="Convert text between UPPERCASE, lowercase, Title Case, camelCase, PascalCase, snake_case, kebab-case, and more. One click."
  toolSlug="case-converter"
  category="text"
>
  <textarea id="case-input" class="w-full h-32 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm resize-y focus:outline-none focus:border-green-500 placeholder-gray-500" placeholder="Type or paste your text here..."></textarea>

  <div class="flex flex-wrap gap-2 mt-3">
    {cases.map(({ label, id }) => (
      <button data-case={id} class="bg-gray-700 hover:bg-gray-600 border border-gray-600 text-sm text-gray-200 px-3 py-1.5 rounded-lg transition-colors font-mono">{label}</button>
    ))}
  </div>

  <div class="mt-3">
    <div class="flex items-center justify-between mb-1">
      <span class="text-xs text-gray-500">Output</span>
      <button id="case-copy" class="text-xs text-green-400 hover:text-green-300 transition-colors">Copy</button>
    </div>
    <textarea id="case-output" readonly class="w-full h-32 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm resize-y focus:outline-none" placeholder="Result appears here..."></textarea>
  </div>

  <script>
    const input = document.getElementById('case-input') as HTMLTextAreaElement;
    const output = document.getElementById('case-output') as HTMLTextAreaElement;

    function words(text: string) {
      return text.trim().replace(/([a-z])([A-Z])/g, '$1 $2').replace(/[-_]+/g, ' ').split(/\s+/).filter(Boolean);
    }

    const converters: Record<string, (t: string) => string> = {
      upper: t => t.toUpperCase(),
      lower: t => t.toLowerCase(),
      title: t => words(t).map(w => w[0].toUpperCase() + w.slice(1).toLowerCase()).join(' '),
      sentence: t => t.toLowerCase().replace(/(^\s*\w|[.!?]\s+\w)/g, c => c.toUpperCase()),
      camel: t => { const w = words(t); return w[0].toLowerCase() + w.slice(1).map(w => w[0].toUpperCase() + w.slice(1).toLowerCase()).join(''); },
      pascal: t => words(t).map(w => w[0].toUpperCase() + w.slice(1).toLowerCase()).join(''),
      snake: t => words(t).map(w => w.toLowerCase()).join('_'),
      kebab: t => words(t).map(w => w.toLowerCase()).join('-'),
    };

    document.querySelectorAll('[data-case]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.case!;
        output.value = converters[id](input.value);
      });
    });

    document.getElementById('case-copy')!.addEventListener('click', () => {
      if (!output.value) return;
      navigator.clipboard.writeText(output.value).then(() => {
        const btn = document.getElementById('case-copy')!;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
    });
  </script>

  <div slot="description">
    <h2 class="text-lg font-semibold text-white mb-2">About this tool</h2>
    <p class="text-gray-400 text-sm leading-relaxed">Convert between 8 common text cases with a single click. The converter intelligently splits camelCase, PascalCase, snake_case, and kebab-case inputs before reconverting, so you can chain conversions freely.</p>
  </div>

  <div slot="related">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">Related tools</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/word-counter/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">Word Counter</a>
      <a href="/tools/remove-duplicate-lines/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">Remove Duplicate Lines</a>
    </div>
  </div>
</ToolLayout>
