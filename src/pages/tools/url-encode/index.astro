---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is URL encoding?', acceptedAnswer: { '@type': 'Answer', text: 'URL encoding (also called percent-encoding) converts characters that are not safe in a URL into a percent sign followed by two hexadecimal digits. For example, a space becomes %20, and & becomes %26. This makes strings safe to include in URLs without breaking their structure.' } },
    { '@type': 'Question', name: 'What is the difference between component and full URL encoding?', acceptedAnswer: { '@type': 'Answer', text: 'Component mode (encodeURIComponent) encodes everything including ?, &, /, and =. Use this for individual query parameter values — for example, when building a URL like example.com?redirect=https%3A%2F%2Fother.com. Full URL mode (encodeURI) preserves URL structure characters like :, /, ?, &, and # and only encodes unsafe characters. Use this when encoding a complete URL.' } },
    { '@type': 'Question', name: 'Is my text sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All encoding and decoding happens entirely in your browser using JavaScript. Your text never leaves your device.' } },
    { '@type': 'Question', name: 'When should I use URL encoding?', acceptedAnswer: { '@type': 'Answer', text: 'Use URL encoding when embedding user input into a URL query string, when building redirect URLs that contain other URLs as parameters, or when passing special characters (spaces, accents, symbols) in URL components. Most HTTP libraries handle this automatically, but manual encoding is sometimes needed for edge cases.' } },
    { '@type': 'Question', name: 'What characters are safe in a URL without encoding?', acceptedAnswer: { '@type': 'Answer', text: 'Unreserved characters are safe without encoding: letters (A–Z, a–z), digits (0–9), and the symbols - _ . ~. All other characters should be percent-encoded in query strings and path segments.' } },
    { '@type': 'Question', name: 'Is URL encoding the same as Base64 encoding?', acceptedAnswer: { '@type': 'Answer', text: 'No. URL encoding converts individual characters to percent-encoded sequences. Base64 converts binary data to a different character set (A–Z, a–z, 0–9, +, /). They serve different purposes. URL encoding is for making text safe in URLs. Base64 is for encoding binary data as printable ASCII.' } },
  ],
};
---

<ToolLayout
  title="URL Encode & Decode Online Free — Toolblip"
  description="Encode and decode URLs or URL components instantly in your browser. Choose full URL or component encoding. No server."
  toolSlug="url-encode"
  category="developer"
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="flex gap-2 mb-3 flex-wrap">
    <button id="url-encode-btn" class="bg-green-600 hover:bg-green-500 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Encode</button>
    <button id="url-decode-btn" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Decode</button>
    <div class="flex items-center gap-3 ml-auto text-sm text-gray-400">
      Mode:
      <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="url-mode" value="component" checked class="accent-green-500"> Component</label>
      <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="url-mode" value="full" class="accent-green-500"> Full URL</label>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div class="text-xs text-gray-500 mb-1">Input</div>
      <textarea id="url-input" class="w-full h-48 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none focus:border-green-500 placeholder-gray-500" placeholder="URL or text to encode/decode..."></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-gray-500">Output</span>
        <button id="url-copy" class="text-xs text-green-400 hover:text-green-300 transition-colors">Copy</button>
      </div>
      <textarea id="url-output" readonly class="w-full h-48 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none" placeholder="Result appears here..."></textarea>
    </div>
  </div>
  <div id="url-error" class="hidden mt-2 text-sm text-red-400 bg-red-900/20 border border-red-800 rounded-lg px-3 py-2"></div>

  <script>
    const input = document.getElementById('url-input') as HTMLTextAreaElement;
    const output = document.getElementById('url-output') as HTMLTextAreaElement;
    const errorEl = document.getElementById('url-error')!;

    function getMode() { return (document.querySelector('input[name="url-mode"]:checked') as HTMLInputElement)?.value ?? 'component'; }

    document.getElementById('url-encode-btn')!.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      try {
        output.value = getMode() === 'full' ? encodeURI(input.value) : encodeURIComponent(input.value);
      } catch(e: any) { errorEl.textContent = `Error: ${e.message}`; errorEl.classList.remove('hidden'); }
    });

    document.getElementById('url-decode-btn')!.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      try {
        output.value = getMode() === 'full' ? decodeURI(input.value) : decodeURIComponent(input.value);
      } catch(e: any) { errorEl.textContent = `Error: ${e.message}`; errorEl.classList.remove('hidden'); }
    });

    document.getElementById('url-copy')!.addEventListener('click', () => {
      if (!output.value) return;
      navigator.clipboard.writeText(output.value).then(() => {
        const btn = document.getElementById('url-copy')!;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
    });
  </script>

  <div slot="description">
    <h2 class="text-lg font-semibold text-white mb-2">About this tool</h2>
    <p class="text-gray-400 text-sm leading-relaxed">
      Encode and decode URLs directly in your browser. <strong class="text-gray-200">Component mode</strong> uses <code class="text-green-400">encodeURIComponent</code> and encodes everything including <code class="text-green-400">?</code>, <code class="text-green-400">&</code>, <code class="text-green-400">/</code>, and <code class="text-green-400">=</code>. Use this for individual query parameter values. <strong class="text-gray-200">Full URL mode</strong> uses <code class="text-green-400">encodeURI</code> and preserves URL structure characters, encoding only unsafe characters.
    </p>
    <p class="text-gray-400 text-sm leading-relaxed mt-2">
      Common use cases include encoding redirect URLs as query parameters, building API request URLs with special characters in search terms, and decoding percent-encoded strings from browser developer tools or log files. Nothing is sent to any server.
    </p>
  </div>

  <div slot="how-to-use">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">How to use</h2>
    <ol class="list-decimal list-inside space-y-2 text-gray-400 text-sm leading-relaxed">
      <li>Paste your text or URL into the Input box on the left.</li>
      <li>Select <strong class="text-gray-200">Component</strong> mode for query parameter values, or <strong class="text-gray-200">Full URL</strong> mode for complete URLs.</li>
      <li>Click <strong class="text-gray-200">Encode</strong> to percent-encode, or <strong class="text-gray-200">Decode</strong> to convert back to plain text.</li>
      <li>Click <strong class="text-gray-200">Copy</strong> to copy the result.</li>
    </ol>
  </div>

  <div slot="faq">
    <h2 class="text-lg font-semibold text-white mb-4 mt-8">Frequently asked questions</h2>
    <div class="space-y-4">
      {faqJsonLd.mainEntity.map((item) => (
        <details class="border border-gray-800 rounded-lg">
          <summary class="px-4 py-3 text-sm font-medium text-gray-200 cursor-pointer hover:text-white">{item.name}</summary>
          <p class="px-4 pb-3 text-sm text-gray-400">{item.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </div>

  <div slot="related">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">Related tools</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/base64/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">Base64 Encode/Decode</a>
      <a href="/tools/json-formatter/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">JSON Formatter</a>
      <a href="/tools/uuid-generator/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">UUID Generator</a>
    </div>
  </div>
</ToolLayout>
