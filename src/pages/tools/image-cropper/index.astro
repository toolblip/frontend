---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const presets = [
  { label: 'Free', ratio: null },
  { label: '1:1', ratio: 1 },
  { label: '4:3', ratio: 4/3 },
  { label: '16:9', ratio: 16/9 },
  { label: '3:4', ratio: 3/4 },
  { label: 'Passport 35×45mm', ratio: 35/45 },
  { label: '2×2 inch', ratio: 1 },
  { label: 'Visa 51×51mm', ratio: 1 },
];
---

<ToolLayout
  title="Image Cropper Online Free — Toolblip"
  description="Crop images to any ratio or preset size — passport, 16:9, square, and more. Pure canvas, no uploads. Download the cropped image instantly."
  toolSlug="image-cropper"
  category="image"
>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

  <div id="ic-drop" class="border-2 border-dashed border-gray-600 hover:border-green-500 rounded-xl p-8 text-center cursor-pointer transition-colors mb-4" id="ic-dropzone">
    <div class="text-gray-400 text-sm">
      <div class="text-3xl mb-2">🖼️</div>
      <p>Drop an image here or <label for="ic-file" class="text-green-400 hover:underline cursor-pointer">browse</label></p>
      <p class="text-xs text-gray-500 mt-1">PNG, JPG, WebP, GIF supported</p>
    </div>
    <input type="file" id="ic-file" accept="image/*" class="hidden" />
  </div>

  <div id="ic-workspace" class="hidden">
    <div class="flex flex-wrap gap-2 mb-3">
      {presets.map(({ label, ratio }) => (
        <button
          data-ratio={ratio ?? 'free'}
          class="text-xs bg-gray-700 hover:bg-gray-600 border border-gray-600 px-3 py-1.5 rounded-lg text-gray-200 transition-colors preset-btn"
        >{label}</button>
      ))}
    </div>
    <div class="rounded-lg overflow-hidden bg-gray-800 border border-gray-700 max-h-96">
      <img id="ic-image" class="block max-w-full" alt="Crop preview" />
    </div>
    <div class="flex gap-2 mt-3">
      <button id="ic-crop" class="bg-green-600 hover:bg-green-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">Crop & Download</button>
      <button id="ic-reset" class="bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-medium px-4 py-2 rounded-lg transition-colors">Reset</button>
    </div>
  </div>

  <script>
    let cropper: any = null;

    async function loadCropper() {
      if ((window as any).Cropper) return;
      await new Promise<void>((res, rej) => {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js';
        s.onload = () => res(); s.onerror = rej;
        document.head.appendChild(s);
      });
    }

    const fileInput = document.getElementById('ic-file') as HTMLInputElement;
    const dropzone = document.getElementById('ic-drop')!;
    const workspace = document.getElementById('ic-workspace')!;
    const imgEl = document.getElementById('ic-image') as HTMLImageElement;

    async function loadImage(file: File) {
      await loadCropper();
      const url = URL.createObjectURL(file);
      imgEl.src = url;
      workspace.classList.remove('hidden');
      dropzone.classList.add('hidden');
      if (cropper) cropper.destroy();
      cropper = new (window as any).Cropper(imgEl, { aspectRatio: NaN, viewMode: 1, autoCropArea: 0.9 });
    }

    fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) loadImage(fileInput.files[0]); });

    dropzone.addEventListener('dragover', e => { e.preventDefault(); dropzone.classList.add('border-green-500'); });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-green-500'));
    dropzone.addEventListener('drop', e => {
      e.preventDefault();
      dropzone.classList.remove('border-green-500');
      const file = e.dataTransfer?.files[0];
      if (file?.type.startsWith('image/')) loadImage(file);
    });
    dropzone.addEventListener('click', () => fileInput.click());

    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (!cropper) return;
        const ratio = (btn as HTMLElement).dataset.ratio;
        cropper.setAspectRatio(ratio === 'free' ? NaN : parseFloat(ratio!));
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('bg-green-600', 'border-green-500'));
        btn.classList.add('bg-green-600', 'border-green-500');
      });
    });

    document.getElementById('ic-crop')!.addEventListener('click', () => {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas();
      canvas.toBlob((blob: Blob) => {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `cropped-${Date.now()}.png`;
        a.click();
      });
    });

    document.getElementById('ic-reset')!.addEventListener('click', () => {
      if (cropper) { cropper.destroy(); cropper = null; }
      workspace.classList.add('hidden');
      dropzone.classList.remove('hidden');
      fileInput.value = '';
    });
  </script>

  <div slot="description">
    <h2 class="text-lg font-semibold text-white mb-2">About this tool</h2>
    <p class="text-gray-400 text-sm leading-relaxed">Drag and drop any image to crop it to an exact ratio or preset size. The cropper uses the browser's canvas API — your image never leaves your device. Cropper.js loads lazily from CDN only when you drop an image.</p>
  </div>

  <div slot="related">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">Related tools</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/base64/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">Image to Base64</a>
    </div>
  </div>
</ToolLayout>
