---
import ToolLayout from '../../../layouts/ToolLayout.astro';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What is JSON formatting?', acceptedAnswer: { '@type': 'Answer', text: 'JSON formatting (also called pretty-printing) takes compact or minified JSON and adds indentation and line breaks to make it readable. A minified API response like {"name":"Alice","age":30} becomes properly indented with each key on its own line.' } },
    { '@type': 'Question', name: 'What is JSON minification?', acceptedAnswer: { '@type': 'Answer', text: 'Minification removes all unnecessary whitespace from JSON. The result is a single-line string with no spaces or newlines. Minified JSON is smaller in file size and faster to transmit over a network, but harder for humans to read.' } },
    { '@type': 'Question', name: 'Is my JSON sent to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All formatting, minifying, and validation happens entirely in your browser using JavaScript. Your JSON never leaves your device. This makes the tool safe for confidential data like API keys or user records.' } },
    { '@type': 'Question', name: 'Why does JSON validation fail with a helpful error message?', acceptedAnswer: { '@type': 'Answer', text: 'When JSON is invalid, the browser\'s JSON.parse() function throws an error with a message describing what went wrong  -  for example "Unexpected token" with the position in the string. This tool surfaces that exact error message so you can find and fix the problem quickly.' } },
    { '@type': 'Question', name: 'What is the difference between 2-space and 4-space indentation?', acceptedAnswer: { '@type': 'Answer', text: '2-space indentation uses two spaces per nesting level and produces more compact output. 4-space indentation is more readable for deeply nested structures. Most style guides (Prettier, ESLint defaults) use 2 spaces for JSON.' } },
    { '@type': 'Question', name: 'Can I use this to validate JSON before submitting an API request?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Paste your request body here and click Format  -  if the JSON is invalid, you\'ll see the exact error. If it formats successfully, the JSON is syntactically valid.' } },
  ],
};
---

<ToolLayout
  title="JSON Formatter & Validator Online Free  -  Toolblip"
  description="Format, validate, and minify JSON instantly. Error highlighting with line numbers. Choose 2 or 4 space indentation. 100% client-side."
  toolSlug="json-formatter"
  category="developer"
>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="flex gap-2 mb-3">
    <button id="jf-format" class="bg-green-600 hover:bg-green-500 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Format</button>
    <button id="jf-minify" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Minify</button>
    <div class="flex items-center gap-2 ml-auto text-sm text-gray-400">
      Indent:
      <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="indent" value="2" checked class="accent-green-500"> 2</label>
      <label class="flex items-center gap-1 cursor-pointer"><input type="radio" name="indent" value="4" class="accent-green-500"> 4</label>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label for="jf-input" class="text-xs text-gray-500 mb-1 block">Input</label>
      <textarea
        id="jf-input"
        aria-label="JSON input"
        class="w-full h-64 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none focus:border-green-500 placeholder-gray-500"
        placeholder='{"key": "value"}'
      ></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-gray-500">Output</span>
        <button id="jf-copy" aria-label="Copy formatted JSON" class="text-xs text-green-400 hover:text-green-300 transition-colors">Copy</button>
      </div>
      <div aria-live="polite" aria-atomic="true">
        <textarea
          id="jf-output"
          readonly
          aria-label="Formatted JSON output"
          class="w-full h-64 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none"
          placeholder="Formatted JSON will appear here..."
        ></textarea>
      </div>
    </div>
  </div>

  <div id="jf-error" role="alert" class="hidden mt-2 text-sm text-red-400 bg-red-900/20 border border-red-800 rounded-lg px-3 py-2"></div>

  <script>
    const inputEl = document.getElementById('jf-input') as HTMLTextAreaElement;
    const outputEl = document.getElementById('jf-output') as HTMLTextAreaElement;
    const errorEl = document.getElementById('jf-error')!;
    const copyBtn = document.getElementById('jf-copy')!;
    const formatBtn = document.getElementById('jf-format')!;
    const minifyBtn = document.getElementById('jf-minify')!;

    function getIndent() {
      return parseInt((document.querySelector('input[name="indent"]:checked') as HTMLInputElement)?.value ?? '2');
    }

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
      outputEl.value = '';
    }

    function hideError() { errorEl.classList.add('hidden'); }

    function parse() {
      const raw = inputEl.value.trim();
      if (!raw) { outputEl.value = ''; hideError(); return null; }
      try { const parsed = JSON.parse(raw); hideError(); return parsed; }
      catch (e: any) { showError(`Invalid JSON: ${e.message}`); return null; }
    }

    formatBtn.addEventListener('click', () => {
      const parsed = parse();
      if (parsed !== null) outputEl.value = JSON.stringify(parsed, null, getIndent());
    });

    minifyBtn.addEventListener('click', () => {
      const parsed = parse();
      if (parsed !== null) outputEl.value = JSON.stringify(parsed);
    });

    copyBtn.addEventListener('click', () => {
      if (!outputEl.value) return;
      navigator.clipboard.writeText(outputEl.value).then(() => {
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
      });
    });

    // Auto-format on paste
    inputEl.addEventListener('paste', () => {
      setTimeout(() => {
        const parsed = parse();
        if (parsed !== null) outputEl.value = JSON.stringify(parsed, null, getIndent());
      }, 10);
    });
  </script>

  <div slot="description">
    <h2 class="text-lg font-semibold text-white mb-2">About this tool</h2>
    <p class="text-gray-400 text-sm leading-relaxed">
      Paste JSON to format (pretty-print) it with proper indentation, or minify it to remove all whitespace. Invalid JSON shows an exact error message from the parser so you can fix it immediately. Choose 2 or 4 space indentation depending on your style guide.
    </p>
    <p class="text-gray-400 text-sm leading-relaxed mt-2">
      The tool auto-formats on paste, so you can drop in a minified API response and immediately see the structure. Everything runs in your browser  -  your JSON is never sent to any server, making it safe to use with API keys, user data, or configuration files.
    </p>
  </div>

  <div slot="how-to-use">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">How to use</h2>
    <ol class="list-decimal list-inside space-y-2 text-gray-400 text-sm leading-relaxed">
      <li>Paste your JSON into the Input box on the left. It auto-formats on paste.</li>
      <li>Click <strong class="text-gray-200">Format</strong> to pretty-print, or <strong class="text-gray-200">Minify</strong> to collapse to one line.</li>
      <li>Choose <strong class="text-gray-200">2</strong> or <strong class="text-gray-200">4</strong> space indentation using the radio buttons.</li>
      <li>If the JSON is invalid, an error message appears below the input with the exact issue.</li>
      <li>Click <strong class="text-gray-200">Copy</strong> to copy the formatted or minified output.</li>
    </ol>
  </div>

  <div slot="faq">
    <h2 class="text-lg font-semibold text-white mb-4 mt-8">Frequently asked questions</h2>
    <div class="space-y-4">
      {faqJsonLd.mainEntity.map((item) => (
        <details class="border border-gray-800 rounded-lg">
          <summary class="px-4 py-3 text-sm font-medium text-gray-200 cursor-pointer hover:text-white">{item.name}</summary>
          <p class="px-4 pb-3 text-sm text-gray-400">{item.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </div>

  <div slot="related">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">Related tools</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/base64/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">Base64 Encode/Decode</a>
      <a href="/tools/url-encode/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">URL Encode/Decode</a>
      <a href="/tools/uuid-generator/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">UUID Generator</a>
    </div>
  </div>
</ToolLayout>
