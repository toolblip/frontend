---
import ToolLayout from '../../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Base64 Encode & Decode Online Free — Toolblip"
  description="Encode and decode Base64 text instantly in your browser. URL-safe Base64 option included. No uploads, no server."
  toolSlug="base64"
  category="developer"
>
  <div class="flex gap-2 mb-3">
    <button id="b64-encode" class="bg-green-600 hover:bg-green-500 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Encode</button>
    <button id="b64-decode" class="bg-gray-700 hover:bg-gray-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg transition-colors">Decode</button>
    <label class="flex items-center gap-2 ml-auto text-sm text-gray-400 cursor-pointer">
      <input type="checkbox" id="b64-urlsafe" class="accent-green-500"> URL-safe
    </label>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <div class="text-xs text-gray-500 mb-1">Input</div>
      <textarea id="b64-input" class="w-full h-48 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none focus:border-green-500 placeholder-gray-500" placeholder="Text to encode or Base64 to decode..."></textarea>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-gray-500">Output</span>
        <button id="b64-copy" class="text-xs text-green-400 hover:text-green-300 transition-colors">Copy</button>
      </div>
      <textarea id="b64-output" readonly class="w-full h-48 bg-gray-800 border border-gray-700 rounded-lg p-3 text-gray-100 text-sm font-mono resize-y focus:outline-none" placeholder="Result appears here..."></textarea>
    </div>
  </div>
  <div id="b64-error" class="hidden mt-2 text-sm text-red-400 bg-red-900/20 border border-red-800 rounded-lg px-3 py-2"></div>

  <script>
    const inputEl = document.getElementById('b64-input') as HTMLTextAreaElement;
    const outputEl = document.getElementById('b64-output') as HTMLTextAreaElement;
    const errorEl = document.getElementById('b64-error')!;
    const urlSafe = document.getElementById('b64-urlsafe') as HTMLInputElement;

    function toUrlSafe(s: string) { return s.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, ''); }
    function fromUrlSafe(s: string) { return s.replace(/-/g, '+').replace(/_/g, '/'); }

    document.getElementById('b64-encode')!.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      try {
        let encoded = btoa(unescape(encodeURIComponent(inputEl.value)));
        if (urlSafe.checked) encoded = toUrlSafe(encoded);
        outputEl.value = encoded;
      } catch { errorEl.textContent = 'Encoding failed. Text must be valid UTF-8.'; errorEl.classList.remove('hidden'); }
    });

    document.getElementById('b64-decode')!.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      try {
        let raw = inputEl.value.trim();
        if (urlSafe.checked) raw = fromUrlSafe(raw);
        outputEl.value = decodeURIComponent(escape(atob(raw)));
      } catch { errorEl.textContent = 'Decoding failed. Input must be valid Base64.'; errorEl.classList.remove('hidden'); }
    });

    document.getElementById('b64-copy')!.addEventListener('click', () => {
      if (!outputEl.value) return;
      navigator.clipboard.writeText(outputEl.value).then(() => {
        const btn = document.getElementById('b64-copy')!;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
      });
    });
  </script>

  <div slot="description">
    <h2 class="text-lg font-semibold text-white mb-2">About this tool</h2>
    <p class="text-gray-400 text-sm leading-relaxed">Encode any text to Base64 or decode Base64 back to text. The URL-safe option replaces <code class="text-green-400">+</code> with <code class="text-green-400">-</code> and <code class="text-green-400">/</code> with <code class="text-green-400">_</code>, making the output safe to use in URLs and filenames without percent-encoding.</p>
  </div>

  <div slot="related">
    <h2 class="text-lg font-semibold text-white mb-3 mt-8">Related tools</h2>
    <div class="flex flex-wrap gap-2">
      <a href="/tools/url-encode/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">URL Encode/Decode</a>
      <a href="/tools/json-formatter/" class="text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 px-3 py-1.5 rounded-lg text-gray-300 hover:text-white transition-colors">JSON Formatter</a>
    </div>
  </div>
</ToolLayout>
