---
import BaseLayout from './BaseLayout.astro';
import SponsorSlot from '../components/SponsorSlot.astro';
import UsageLimitPopup from '../components/UsageLimitPopup.astro';

interface Props {
  title: string;
  description: string;
  toolSlug: string;
  category: string;
  canonical?: string;
}

const { title, description, toolSlug, category, canonical } = Astro.props;

const crontinel = {
  name: 'Crontinel',
  tagline: 'Monitor your Laravel cron jobs and queues. Free to start.',
  url: 'https://crontinel.com',
  color: '#4ade80',
  logoSvg: `<svg width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="10" stroke="#4ade80" stroke-width="2"/><path d="M11 6v5.5l3 3" stroke="#4ade80" stroke-width="2" stroke-linecap="round"/></svg>`,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolblip.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://toolblip.com/tools/' },
    { '@type': 'ListItem', position: 3, name: title, item: `https://toolblip.com/tools/${toolSlug}/` },
  ],
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description,
  url: `https://toolblip.com/tools/${toolSlug}/`,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <slot name="jsonld" />
  </Fragment>

  <!-- Breadcrumb -->
  <div class="border-b border-gray-800 bg-gray-900/40">
    <div class="max-w-4xl mx-auto px-4 py-2 text-sm text-gray-500 flex gap-2">
      <a href="/" class="hover:text-gray-300 transition-colors">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-gray-300 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-gray-300">{title}</span>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Tool header -->
    <h1 class="text-2xl font-bold text-white mb-2">{title}</h1>
    <p class="text-gray-400 mb-6">{description}</p>

    <!-- Ad slot: above tool -->
    <SponsorSlot sponsor={crontinel} position="above" />

    <!-- Tool content -->
    <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8">
      <slot />
      <UsageLimitPopup toolName={title} />
    </div>

    <!-- Ad slot: below tool -->
    <SponsorSlot sponsor={crontinel} position="below" />

    <!-- Tool description -->
    <div class="prose prose-invert prose-sm max-w-none mb-8">
      <slot name="description" />
    </div>

    <!-- How to use -->
    <slot name="how-to-use" />

    <!-- FAQ -->
    <slot name="faq" />

    <!-- Related tools -->
    <slot name="related" />
  </div>
</BaseLayout>

<script>
  import { incrementUsage, GUEST_DAILY_LIMIT } from '../lib/usage';

  const DISMISSED_KEY = 'tb_popup_dismissed';

  function showPopupIfEligible() {
    if (sessionStorage.getItem(DISMISSED_KEY)) return;
    const popup = document.getElementById('usage-limit-popup');
    if (popup) popup.classList.remove('hidden');
  }

  // Expose global tracker for individual tool pages to call after each tool action
  (window as any).__tbTrackUse = function (slug: string) {
    const newCount = incrementUsage(slug);
    if (newCount >= GUEST_DAILY_LIMIT) {
      showPopupIfEligible();
    }
  };
</script>
