---
interface Props {
  toolName?: string;
}

const { toolName } = Astro.props;
const headline = toolName
  ? `You've used ${toolName} 10 times today`
  : "You've used this tool 10 times today";
---

<div
  id="usage-limit-popup"
  class="hidden mb-4 rounded-xl border border-amber-500/30 bg-amber-500/10 px-5 py-4"
  role="alert"
>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
    <div class="flex-1 min-w-0">
      <p class="font-semibold text-amber-300 text-sm">{headline}</p>
      <p class="text-gray-400 text-sm mt-0.5">
        Free account gives you 50 uses/day + save favourite tools.
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="/signup"
        class="bg-green-500 hover:bg-green-400 text-black font-semibold text-sm px-4 py-2 rounded-lg transition-colors whitespace-nowrap"
      >
        Sign up free
      </a>
      <button
        id="usage-popup-dismiss"
        class="text-gray-500 hover:text-gray-300 text-sm transition-colors whitespace-nowrap"
        type="button"
      >
        Maybe later
      </button>
    </div>
  </div>
</div>

<script>
  const DISMISSED_KEY = 'tb_popup_dismissed';
  const popup = document.getElementById('usage-limit-popup');
  const dismissBtn = document.getElementById('usage-popup-dismiss');

  // Show popup if not dismissed this session
  if (popup && !sessionStorage.getItem(DISMISSED_KEY)) {
    popup.classList.remove('hidden');
  }

  dismissBtn?.addEventListener('click', () => {
    sessionStorage.setItem(DISMISSED_KEY, '1');
    popup?.classList.add('hidden');
  });
</script>
