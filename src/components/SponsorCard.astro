---
interface Sponsor {
  name: string;
  tagline: string;
  url: string;
  brandColor: string;
  logo: string;
  cta: string;
}

interface Props {
  sponsor: Sponsor;
}

const { sponsor } = Astro.props;
---

<a
  href={sponsor.url}
  target="_blank"
  rel="noopener noreferrer sponsored"
  class="sponsor-card group block rounded-xl p-4 transition-all duration-200 hover:opacity-90 hover:shadow-lg"
  style={`background-color: ${sponsor.brandColor};`}
  aria-label={`Sponsored by ${sponsor.name}: ${sponsor.tagline}`}
>
  <div class="flex items-center justify-between gap-4">
    <div class="flex flex-col gap-1 min-w-0">
      <img
        src={sponsor.logo}
        alt={sponsor.name}
        width="120"
        height="40"
        class="h-8 w-auto object-contain object-left"
        loading="lazy"
      />
      <p class="text-sm text-green-100/90 leading-snug truncate">{sponsor.tagline}</p>
    </div>
    <span
      class="shrink-0 rounded-lg bg-white/15 px-3 py-1.5 text-xs font-semibold text-white whitespace-nowrap group-hover:bg-white/25 transition-colors"
    >
      {sponsor.cta}
    </span>
  </div>
  <span class="sr-only">Sponsored</span>
</a>
