---
interface Props {
  name: string;
  tagline: string;
  url: string;
  color: string;
  logoSvg?: string;
}

const { name, tagline, url, logoSvg } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="relative flex items-center gap-4 bg-gray-800 border border-gray-700 rounded-xl px-4 py-3 hover:border-gray-600 transition-colors no-underline group"
>
  <span class="absolute top-2 right-3 text-xs text-gray-600 font-normal">Sponsored</span>

  <div class="flex items-center gap-3 flex-1 min-w-0">
    {logoSvg && <span class="shrink-0" set:html={logoSvg} />}
    <div class="min-w-0">
      <p class="text-white font-semibold text-sm leading-tight">{name}</p>
      <p class="text-gray-400 text-xs mt-0.5 truncate">{tagline}</p>
    </div>
  </div>

  <span class="shrink-0 bg-green-500 hover:bg-green-400 text-black font-medium text-xs px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap">
    Try free →
  </span>
</a>
